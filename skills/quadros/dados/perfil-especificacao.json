  "verificacoes": {
    "descricao": "Regras que confrontam o que o cliente pediu (pontos a levantar), geram o que falta confirmar (pendências) e o que declarar na proposta (exceções). Condições: 'f:<fato>' (fato calculado pela solução), 'req:<id>', 'decisao:<chave>=<valor>'; prefixo '!' nega. Texto com {variáveis} da solução. 'sugestao' é a alternativa que o engenheiro pode aprovar (vira decisão aprendida e padrão para o próximo quadro); 'se_mantido' é a exceção declarada quando ele responde 'manter como pedido'.",
    "regras": [
      { "id": "titular_x_automacao", "tipo": "ponto", "se": ["f:titular_2pos", "req:automacao.entrada_selecao_titular"],
        "texto": "Seletora titular × automação: com a seletora {stit} de 2 posições e a entrada da automação (X3) em paralelo, a automação só consegue forçar {ultimo} (com a seletora em {ultimo}, a automação não volta para {m1}).",
        "sugestao": { "decisao": "titular_automacao", "valor": "REMOTO", "texto": "Seletora {stit} de 3 posições {m1} · REM · {ultimo}: em REM quem escolhe é a automação. Custo marginal; recomendado oferecer como alternativa." },
        "se_mantido": "Seletora titular × automação: com {stit} em {ultimo} e a entrada X3 em paralelo, a automação só consegue forçar {ultimo}. Alternativa: {stit} com 3 posições {m1} · REM · {ultimo}." },
      { "id": "reserva_sem_troca", "tipo": "ponto", "se": ["f:motores_reserva", "f:titular"], "nao": ["decisao:troca_automatica=SIM"],
        "texto": "Não há troca automática por falha: em AUT, se a titular falhar, a reserva não parte sozinha — o operador muda a seletora titular (ou a automação futura, via X3/X4).",
        "sugestao": { "decisao": "troca_automatica", "valor": "SIM", "texto": "Opcional: troca automática por falha — a falha da titular (KF) passa a titular para a reserva (lógica no KT, sem relé a mais)." },
        "se_mantido": "Troca automática por falha não faz parte deste fornecimento: em AUT, se a titular falhar, a reserva não parte sozinha — o operador muda {stit} (ou a automação futura, via X3/X4)." },
      { "id": "emergencia_sem_corte", "tipo": "ponto", "se": ["req:comando.emergencia", "f:acionamento"], "nao": ["decisao:contator_emergencia=SIM"],
        "texto": "A emergência corta o comando (partida dos acionamentos e liberação), mas não a força dos inversores — não há contator de linha na especificação. NBR IEC 60204-1 (9.2.2, 10.7) e NR-12: a categoria de parada sai da apreciação de risco. [CONFERIR]",
        "sugestao": { "decisao": "contator_emergencia", "valor": "SIM", "texto": "Prever um contator na entrada de cada inversor, aberto pela cadeia de emergência (KE)." },
        "se_mantido": "Emergência por relé auxiliar (KE): corta a partida dos acionamentos e a liberação dos {externos}; não secciona a força. Se o cliente exigir corte de força na emergência, prever contator na entrada dos inversores (não pedido na especificação)." },
      { "id": "pend_icc", "tipo": "pendencia", "nao": ["f:icc_informado"], "texto": "Icc presumido no {origem} → define o Icu do geral e das saídas, a filiação dos minidisjuntores, o Icw do barramento e a versão (e o preço) dos disjuntores." },
      { "id": "pend_rla", "tipo": "pendencia", "se": ["f:hvac_sem_rla"], "texto": "Dados do fabricante dos {externos} (RLA/LRA) → confirmar o geral de {geral} (a demanda usa a MCA, conservadora) e a seletividade com as saídas." },
      { "id": "pend_valvula_borne", "tipo": "pendencia", "se": ["f:valvula_borne_conferir"], "texto": "Borne do contato de comando da válvula na placa do {externo} (a especificação diz \"a confirmar\")." },
      { "id": "pend_atuador", "tipo": "pendencia", "se": ["f:valvulas", "f:atuador_tipo_conferir"], "texto": "Atuador da válvula: 24 Vca ou 24 Vcc e consumo (VA/W). Com 24 Vca, trocar a fonte do circuito das válvulas por transformador 220/24 Vca." },
      { "id": "pend_inversor", "tipo": "pendencia", "se": ["f:acionamento"], "texto": "{acionModelo}: bornes de partida (DI/COM), relé de falha e saída \"em funcionamento\" — confirmar no manual. Se houver só 1 relé, usar a saída transistorizada (DO) para KR." },
      { "id": "pend_ui", "tipo": "pendencia", "se": ["f:sinal_ui"], "texto": "Entrada {sinal_ui} da placa do {externo} configurada como entrada digital para contato seco." },
      { "id": "pend_cabos", "tipo": "pendencia", "se": ["f:tem_cargas"], "texto": "Comprimento dos cabos até as cargas (queda de tensão e seção dos cabos de campo, fora do fornecimento); inversor → motor > 50 m: avaliar reator/filtro dV/dt." },
      { "id": "pend_montante", "tipo": "pendencia", "se": ["f:geral"], "texto": "Alimentador e proteção a montante no {origem} compatíveis com o geral de {geral} (fora do fornecimento)." },
      { "id": "exc_velocidade", "tipo": "excecao", "se": ["f:acionamento_inversor"], "nao": ["req:comando.controle_velocidade"], "texto": "Partida/parada sempre pelo inversor; velocidade fixa parametrizada no inversor (sem controle de vazão)." },
      { "id": "exc_valvulas", "tipo": "excecao", "se": ["req:valvulas.independente_emergencia", "f:valvulas"], "texto": "Válvulas alimentadas por circuito próprio (F2), fora da cadeia de emergência; com qualquer motor em MANUAL, KMAN abre as válvulas." },
      { "id": "exc_cliente", "tipo": "excecao", "se": ["f:acion_cliente"], "texto": "{acionModelo} fornecidos pelo cliente: somente montagem e ligação no quadro; parametrização conforme o manual do fabricante [CONFERIR escopo]." },
