{
 "versao": 1,
 "descricao": "Biblioteca de BLOCOS DE FUNÇÃO de comando por relés (24 Vcc). Cada bloco é um modelo: entradas (seletoras, botões, sinais de campo), relés, degraus da escada (expressões série/paralelo), equipamentos de campo (inversor, soft-starter), saídas de contato para o campo, cenários de verificação e textos. O compilador (comando.js) instancia os blocos pedidos pelo perfil, numera os contatos (11-14, 21-24…) e as réguas de bornes. Expressão: {s:[…]} série, {p:[…]} paralelo, {x:'SINAL', neg:true} contato; {p_de:'motores', leaf:{…}} repete por item. Placeholders: {i} {tag} {rotulo} {ROTULO} {acion} {m.tag} {e.tag} {e.sinal.pedido} {motores} {externos} {ultimo.tag}. Condição 'se': 'req:<id>', 'bloco:<id>', 'decisao:<chave>=<valor>', 'motores>=2', 'acionamento', 'acion_cliente', 'externos>=1'.",
 "barras_base": [
  {
   "tag": "L+",
   "rotulo": "+24 Vcc (fonte G1 / F1)",
   "expr": {
    "s": [
     {
      "x": "energia"
     },
     {
      "x": "F1"
     }
    ]
   }
  },
  {
   "tag": "LV+",
   "rotulo": "+24 V das válvulas (F2 — independente da emergência)",
   "expr": {
    "s": [
     {
      "x": "energia"
     },
     {
      "x": "F2"
     }
    ]
   },
   "se": "bloco:valvula_por_equipamento"
  },
  {
   "tag": "FN",
   "rotulo": "220 Vca (fase-neutro, disjuntor de comando)",
   "expr": {
    "x": "energia"
   }
  }
 ],
 "entradas_base": [
  {
   "id": "energia",
   "tipo": "energia",
   "rotulo": "Alimentação do quadro"
  },
  {
   "id": "F1",
   "tipo": "fusivel",
   "rotulo": "Fusível F1 (comando)"
  },
  {
   "id": "F2",
   "tipo": "fusivel",
   "rotulo": "Fusível F2 (válvulas)",
   "se": "bloco:valvula_por_equipamento"
  },
  {
   "id": "CMD.AUT",
   "tipo": "externo",
   "rotulo": "Comando automático externo (contato seco na X3) [CONFERIR]",
   "se": [
    "bloco:motor_man_0_aut",
    "!bloco:pedido_externo",
    "!bloco:partida_por_alarme",
    "!bloco:comando_por_chiller"
   ],
   "campo": {
    "regua": "X3",
    "rotulos": [
     "comando automático externo (+24 V)",
     "comando automático externo (retorno)"
    ]
   }
  }
 ],
 "blocos": [
  {
   "id": "emergencia_rele",
   "rotulo": "Emergência por relé auxiliar (KE)",
   "se": [
    "req:comando.emergencia"
   ],
   "entradas": [
    {
     "id": "S0",
     "tipo": "emergencia",
     "rotulo": "EMERGÊNCIA",
     "porta": true,
     "material": "emergencia",
     "descricao": "Botão de emergência cogumelo Ø 40 mm, girar para soltar, 1 NF, com anel amarelo"
    },
    {
     "id": "RFF",
     "tipo": "supervisor",
     "rotulo": "Relé de falta/sequência de fase (fase OK)",
     "se": "req:forca.rff"
    }
   ],
   "reles": [
    {
     "tag": "KE",
     "rotulo": "emergência e fases OK"
    }
   ],
   "degraus": [
    {
     "barra": "L+",
     "expr": {
      "s": [
       {
        "x": "RFF",
        "se": "req:forca.rff",
        "contato": "11-14",
        "rotulo": "RFF fase OK"
       },
       {
        "x": "S0",
        "neg": true,
        "rotulo": "S0 emergência"
       }
      ]
     },
     "saida": "KE",
     "rotulo": "emergência / fases OK"
    }
   ],
   "barras": [
    {
     "tag": "L+E",
     "rotulo": "+24 Vcc após a emergência (KE)",
     "expr": {
      "x": "KE"
     }
    }
   ],
   "cenarios": [
    {
     "nome": "Emergência acionada desliga KE (cadeia L+E sem tensão)",
     "entradas": {
      "S0": true
     },
     "espera": {
      "KE": false,
      "L+E": false
     }
    },
    {
     "nome": "Falta de fase (RFF) desliga KE",
     "se": "req:forca.rff",
     "entradas": {
      "RFF": false
     },
     "espera": {
      "KE": false
     }
    }
   ],
   "logica": [
    "S0 (emergência){rff_texto} em série alimentam KE; KE fecha a barra L+E. Sem KE, cai L+E: param os acionamentos e sai a liberação."
   ],
   "notas": [
    "Emergência por relé auxiliar (KE): retira o comando de partida dos acionamentos e a liberação do equipamento externo; não secciona a força. A categoria de parada depende da parametrização do inversor (rampa = cat. 1; inércia = cat. 0) — NBR IEC 60204-1, 9.2.2 [CONFERIR com a apreciação de risco]."
   ]
  },
  {
   "id": "liberacao_externa",
   "rotulo": "Liberação do equipamento externo (seletora + KL)",
   "se": [
    "req:comando.liberacao",
    "externos>=1"
   ],
   "entradas": [
    {
     "id": "S{n_lib}",
     "alias": "SLIB",
     "tipo": "seletora",
     "posicoes": [
      "DESL",
      "LIB"
     ],
     "padrao": "DESL",
     "rotulo": "LIBERAÇÃO {EXTERNOS}",
     "porta": true,
     "material": "seletora2",
     "descricao": "Seletora 22 mm 2 posições fixas (DESL · LIB)"
    }
   ],
   "reles": [
    {
     "tag": "KL",
     "rotulo": "libera {externos}"
    }
   ],
   "degraus": [
    {
     "barra": "{barra_motor}",
     "expr": {
      "x": "SLIB=LIB"
     },
     "saida": "KL",
     "rotulo": "liberação {externos}"
    }
   ],
   "saidasCampo": [
    {
     "por": "externos",
     "tag": "{e.tag}.LIBERADO",
     "expr": {
      "x": "KL"
     },
     "rotulo": "liberação remota {e.rotulo} ({e.sinal.liberacao})",
     "borne": {
      "regua": "X2",
      "rotulos": [
       "{e.tag} {e.sinal.liberacao} (KL)",
       "{e.tag} {e.sinal.liberacao} comum"
      ]
     }
    }
   ],
   "cenarios": [
    {
     "nome": "Liberação em LIB libera os equipamentos externos",
     "entradas": {
      "SLIB": "LIB"
     },
     "espera": {
      "KL": true,
      "{e1.tag}.LIBERADO": true
     }
    },
    {
     "nome": "Emergência retira a liberação",
     "se": "bloco:emergencia_rele",
     "entradas": {
      "SLIB": "LIB",
      "S0": true
     },
     "espera": {
      "KL": false,
      "{e1.tag}.LIBERADO": false
     }
    }
   ],
   "logica": [
    "{SLIB} em LIB energiza KL (sob L+E); os contatos de KL vão à entrada de liberação de cada {externo} ({e1.sinal.liberacao})."
   ]
  },
  {
   "id": "pedido_externo",
   "rotulo": "Pedido de partida pelo equipamento externo (KP)",
   "se": [
    "req:comando.automatico_pedido",
    "externos>=1"
   ],
   "entradas": [
    {
     "por": "externos",
     "id": "{e.tag}.PEDIDO",
     "tipo": "externo",
     "rotulo": "{e.rotulo} pede {motor} ({e.sinal.pedido})",
     "campo": {
      "regua": "X2",
      "rotulos": [
       "{e.tag} {e.sinal.pedido} (+24 V)",
       "{e.tag} {e.sinal.pedido} (retorno KP)"
      ]
     }
    }
   ],
   "reles": [
    {
     "tag": "KP",
     "rotulo": "pedido de {motor}"
    }
   ],
   "degraus": [
    {
     "barra": "L+",
     "expr": {
      "combinar_de": "externos",
      "leaf": {
       "x": "{e.tag}.PEDIDO",
       "rotulo": "{e.sinal.pedido} {e.tag}"
      }
     },
     "saida": "KP",
     "rotulo": "pedido de {motor} ({combinacao})"
    }
   ],
   "cenarios": [
    {
     "nome": "Pedido de um equipamento externo energiza KP",
     "entradas": {
      "{e1.tag}.PEDIDO": true
     },
     "espera": {
      "KP": true
     }
    }
   ],
   "logica": [
    "Os contatos de pedido ({e1.sinal.pedido}) dos {externos} em {combinacao_texto} energizam KP."
   ]
  },
  {
   "id": "titular_reserva",
   "rotulo": "Seleção da titular (KT)",
   "se": [
    "req:comando.titular_reserva",
    "motores==2"
   ],
   "entradas": [
    {
     "id": "S{n_tit}",
     "alias": "STIT",
     "tipo": "seletora",
     "posicoes": [
      "{m1.tag}",
      "{ultimo.tag}"
     ],
     "padrao": "{m1.tag}",
     "rotulo": "{MOTOR} TITULAR {m1.tag} · {ultimo.tag}",
     "porta": true,
     "material": "seletora2",
     "descricao": "Seletora 22 mm 2 posições fixas ({m1.tag} · {ultimo.tag})"
    },
    {
     "id": "AUT.TITULAR",
     "tipo": "externo",
     "rotulo": "Automação seleciona {ultimo.tag} como titular",
     "se": "req:automacao.entrada_selecao_titular",
     "campo": {
      "regua": "X3",
      "rotulos": [
       "entrada seleção titular (+24 V)",
       "entrada seleção titular (retorno KT)"
      ]
     }
    }
   ],
   "reles": [
    {
     "tag": "KT",
     "rotulo": "titular = {ultimo.tag}"
    }
   ],
   "degraus": [
    {
     "barra": "L+",
     "expr": {
      "p": [
       {
        "x": "STIT={ultimo.tag}"
       },
       {
        "x": "AUT.TITULAR",
        "se": "req:automacao.entrada_selecao_titular",
        "rotulo": "automação (X3)"
       }
      ]
     },
     "saida": "KT",
     "rotulo": "titular = {ultimo.tag}"
    }
   ],
   "variantes": {
    "titular_automacao=REMOTO": {
     "rotulo": "Seleção da titular com posição REM (a automação escolhe)",
     "entradas": [
      {
       "id": "S{n_tit}",
       "alias": "STIT",
       "tipo": "seletora",
       "posicoes": [
        "{m1.tag}",
        "REM",
        "{ultimo.tag}"
       ],
       "padrao": "{m1.tag}",
       "rotulo": "{MOTOR} TITULAR {m1.tag} · REM · {ultimo.tag}",
       "porta": true,
       "material": "seletora3",
       "descricao": "Seletora 22 mm 3 posições fixas ({m1.tag} · REM · {ultimo.tag})"
      },
      {
       "id": "AUT.TITULAR",
       "tipo": "externo",
       "rotulo": "Automação seleciona {ultimo.tag} como titular (em REM)",
       "campo": {
        "regua": "X3",
        "rotulos": [
         "entrada seleção titular (+24 V)",
         "entrada seleção titular (retorno KT)"
        ]
       }
      }
     ],
     "degraus": [
      {
       "barra": "L+",
       "expr": {
        "p": [
         {
          "x": "STIT={ultimo.tag}"
         },
         {
          "s": [
           {
            "x": "STIT=REM"
           },
           {
            "x": "AUT.TITULAR",
            "rotulo": "automação (X3)"
           }
          ]
         }
        ]
       },
       "saida": "KT",
       "rotulo": "titular = {ultimo.tag}"
      }
     ],
     "logica": [
      "{STIT} em {ultimo.tag} energiza KT; em REM quem escolhe é a automação (X3); em {m1.tag}, KT desligado (titular = {m1.tag})."
     ]
    },
    "troca_automatica=SIM": {
     "rotulo": "Seleção da titular com troca automática por falha",
     "degraus": [
      {
       "barra": "L+",
       "expr": {
        "s": [
         {
          "p": [
           {
            "x": "STIT={ultimo.tag}"
           },
           {
            "s": [
             {
              "x": "STIT=REM"
             },
             {
              "x": "AUT.TITULAR",
              "rotulo": "automação (X3)"
             }
            ],
            "se": "decisao:titular_automacao=REMOTO"
           },
           {
            "x": "AUT.TITULAR",
            "rotulo": "automação (X3)",
            "se": [
             "!decisao:titular_automacao=REMOTO",
             "req:automacao.entrada_selecao_titular"
            ]
           },
           {
            "x": "KF{m1.i}",
            "rotulo": "falha {m1.tag} → troca",
            "se": "bloco:status_acionamento"
           }
          ]
         },
         {
          "x": "KF{ultimo.i}",
          "neg": true,
          "rotulo": "falha {ultimo.tag} → volta",
          "se": "bloco:status_acionamento"
         }
        ]
       },
       "saida": "KT",
       "rotulo": "titular = {ultimo.tag} (com troca por falha)"
      }
     ],
     "cenarios": [
      {
       "nome": "Titular {ultimo.tag} pela seletora energiza KT",
       "entradas": {
        "STIT": "{ultimo.tag}"
       },
       "espera": {
        "KT": true
       }
      },
      {
       "nome": "Troca automática: falha na titular {m1.tag} em AUT passa a titular para {ultimo.tag}",
       "se": "bloco:pedido_externo",
       "entradas": {
        "S{m1.i}": "AUT",
        "S{ultimo.i}": "AUT",
        "STIT": "{m1.tag}",
        "{e1.tag}.PEDIDO": true,
        "{m1.acion}.falha": true
       },
       "espera": {
        "KT": true,
        "KB{ultimo.i}": true,
        "KB{m1.i}": false
       }
      },
      {
       "nome": "Troca automática: falha na titular {ultimo.tag} volta para {m1.tag}",
       "se": "bloco:pedido_externo",
       "entradas": {
        "S{m1.i}": "AUT",
        "S{ultimo.i}": "AUT",
        "STIT": "{ultimo.tag}",
        "{e1.tag}.PEDIDO": true,
        "{ultimo.acion}.falha": true
       },
       "espera": {
        "KT": false,
        "KB{m1.i}": true
       }
      }
     ],
     "logica": [
      "{STIT} escolhe a titular; a falha da titular (KF) passa a titular para a outra (troca automática por falha), sem relé a mais."
     ]
    }
   },
   "cenarios": [
    {
     "nome": "Titular {ultimo.tag} pela seletora energiza KT",
     "entradas": {
      "STIT": "{ultimo.tag}"
     },
     "espera": {
      "KT": true
     }
    },
    {
     "nome": "Automação seleciona {ultimo.tag} (entrada X3)",
     "se": "req:automacao.entrada_selecao_titular",
     "entradas": {
      "STIT": "{remoto_pos}",
      "AUT.TITULAR": true
     },
     "espera": {
      "KT": true
     }
    }
   ],
   "logica": [
    "{STIT} em {ultimo.tag} (ou a automação pela X3, em paralelo) energiza KT → titular = {ultimo.tag}; KT desligado → titular = {m1.tag}."
   ]
  },
  {
   "id": "motor_man_0_aut",
   "rotulo": "Comando MAN-0-AUT por motor (KB)",
   "por": "motores",
   "se": [
    "req:comando.seletora_man_0_aut"
   ],
   "entradas": [
    {
     "id": "S{i}",
     "tipo": "seletora",
     "posicoes": [
      "MAN",
      "0",
      "AUT"
     ],
     "padrao": "0",
     "rotulo": "{ROTULO} MAN · 0 · AUT",
     "porta": true,
     "material": "seletora3",
     "descricao": "Seletora 22 mm 3 posições fixas MAN–0–AUT"
    }
   ],
   "reles": [
    {
     "tag": "KB{i}",
     "rotulo": "partida {tag}"
    }
   ],
   "degraus": [
    {
     "barra": "{barra_motor}",
     "expr": {
      "p": [
       {
        "x": "S{i}=MAN",
        "rotulo": "S{i} MAN"
       },
       {
        "s": [
         {
          "x": "S{i}=AUT",
          "rotulo": "S{i} AUT"
         },
         {
          "x": "KC{i}",
          "se": "bloco:comando_por_chiller",
          "rotulo": "KC{i} comando do chiller"
         },
         {
          "x": "KP",
          "se": "bloco:pedido_externo"
         },
         {
          "x": "KT",
          "neg": "{titular_neg}",
          "se": "bloco:titular_reserva"
         },
         {
          "x": "KA",
          "se": "bloco:partida_por_alarme",
          "rotulo": "KA comando automático"
         },
         {
          "x": "KREV",
          "neg": "{rev_neg}",
          "se": "bloco:reversao_automatica"
         },
         {
          "x": "CMD.AUT",
          "rotulo": "comando automático externo (X3)",
          "se": [
           "!bloco:pedido_externo",
           "!bloco:partida_por_alarme",
           "!bloco:comando_por_chiller"
          ]
         }
        ]
       }
      ]
     },
     "saida": "KB{i}",
     "rotulo": "partida {tag}"
    }
   ],
   "saidasCampo": [
    {
     "tag": "{acion}.DI",
     "se": "acionamento",
     "expr": {
      "x": "KB{i}"
     },
     "rotulo": "partida {tag} (entrada digital do {acion})",
     "borne": {
      "se": "acion_cliente",
      "regua": "X2",
      "rotulos": [
       "{acion} COM",
       "{acion} DI1 (partida, KB{i})"
      ]
     }
    }
   ],
   "equipamentos": [
    {
     "se": "acionamento",
     "tag": "{acion}",
     "rotulo": "{acionRotulo} {acion} ({tag})",
     "saidas": {
      "RUN": {
       "s": [
        {
         "x": "{acion}.DI"
        },
        {
         "x": "{acion}.falha",
         "neg": true
        },
        {
         "x": "energia"
        }
       ]
      },
      "FALHA": {
       "x": "{acion}.falha"
      }
     }
    }
   ],
   "entradasExtras": [
    {
     "se": "acionamento",
     "id": "{acion}.falha",
     "tipo": "falha",
     "rotulo": "Falha no {acion} ({tag})"
    }
   ],
   "cenarios": [
    {
     "nome": "{tag} em MAN parte sem o comando automático",
     "entradas": {
      "S{i}": "MAN"
     },
     "espera": {
      "KB{i}": true,
      "{acion}.RUN": true
     }
    },
    {
     "nome": "{tag} em 0 fica desligada mesmo com pedido",
     "se": "bloco:pedido_externo",
     "entradas": {
      "S{i}": "0",
      "{e1.tag}.PEDIDO": true,
      "{titular_entradas}": ""
     },
     "espera": {
      "KB{i}": false
     }
    },
    {
     "nome": "{tag} em AUT parte com o pedido de qualquer equipamento externo quando é a titular",
     "se": "bloco:pedido_externo",
     "entradas": {
      "S{i}": "AUT",
      "{ultimo_e.tag}.PEDIDO": true,
      "{titular_entradas}": "{titular_pos}"
     },
     "espera": {
      "KB{i}": true,
      "{acion}.RUN": true
     }
    },
    {
     "nome": "{tag} em AUT não parte quando não é a titular",
     "se": "bloco:titular_reserva",
     "entradas": {
      "S{i}": "AUT",
      "{e1.tag}.PEDIDO": true,
      "{titular_entradas}": "{nao_titular_pos}"
     },
     "espera": {
      "KB{i}": false
     }
    },
    {
     "nome": "Emergência para a {tag} mesmo em MAN",
     "se": "bloco:emergencia_rele",
     "entradas": {
      "S{i}": "MAN",
      "S0": true
     },
     "espera": {
      "KB{i}": false,
      "{acion}.RUN": false
     }
    },
    {
     "nome": "{tag} em AUT parte com o alarme da central{lider_txt}",
     "se": [
      "bloco:partida_por_alarme",
      "{so_lider}"
     ],
     "entradas": {
      "S{i}": "AUT",
      "CENTRAL.ALARME": true
     },
     "espera": {
      "KB{i}": true
     }
    },
    {
     "nome": "{tag} em MAN parte mesmo com a central normal",
     "se": "bloco:partida_por_alarme",
     "entradas": {
      "S{i}": "MAN"
     },
     "espera": {
      "KB{i}": true
     }
    }
   ],
   "logica": [
    "MAN: KB{i} liga direto pela seletora, sem depender do comando automático{sob_emergencia}.",
    "AUT: KB{i} liga com o comando automático{aut_texto}{titular_texto}{reversao_texto}."
   ],
   "notas": [
    "Partida/parada sempre pelo acionamento: KB{i} fecha a entrada digital de partida do {acion}."
   ]
  },
  {
   "id": "partida_por_alarme",
   "rotulo": "Partida automática pelo alarme de incêndio (KA)",
   "se": [
    "req:comando.partida_alarme"
   ],
   "entradas": [
    {
     "id": "CENTRAL.ALARME",
     "tipo": "externo",
     "rotulo": "Central de alarme: alarme de incêndio (módulo de comando)",
     "campo": {
      "regua": "X2",
