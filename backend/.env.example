PORT=3001
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hm_orcamentos
DB_USER=postgres
DB_PASS=SUA_SENHA_AQUI
# OBRIGATÓRIO: mínimo 32 caracteres. O sistema NÃO inicia sem isso (antes ele
# subia com um segredo padrão do código, o que permitia forjar token de admin).
# Gere o seu:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Só usados na PRIMEIRA instalação, quando ainda não existe nenhum usuário.
# Se ADMIN_SENHA_INICIAL ficar em branco, o sistema sorteia uma senha e mostra
# no console durante o primeiro boot.
ADMIN_EMAIL_INICIAL=admin@hmengenharia.com
ADMIN_SENHA_INICIAL=

# Importação automática de notas fiscais por e-mail (opcional).
# Deixe em branco / remova para desativar a funcionalidade.
# Veja no README como gerar a senha de app do Gmail.
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=email-da-empresa@gmail.com
EMAIL_IMAP_APP_PASSWORD=

# Extração de projetos (PDF) em rascunho de orçamento, via Gemini (Google AI Studio).
# Gere uma chave em https://aistudio.google.com/apikey — deixe em branco para desativar.
GEMINI_API_KEY=

# Pesquisa de mercado (preço de material/equipamento) via Claude (Anthropic) —
# usado só como FALLBACK PAGO quando a cota diária grátis do Gemini estourar
# em todos os modelos (testamos usar o Claude para ler o PDF do projeto
# inteiro no lugar do Gemini/regex e saiu pior — menos confiável nesse uso —
# por isso ficou restrito à pesquisa de mercado, onde funciona bem). Pago
# desde a primeira chamada (sem cota grátis). Gere em
# https://console.anthropic.com (API Keys) e carregue crédito em Plans & Billing.
# Deixe em branco para desativar (a pesquisa de mercado cai só no Gemini).
ANTHROPIC_API_KEY=

# Região da referência de mercado de mão de obra (tela Preços de Mão de Obra):
# UF da SINAPI na referência oficial e região do mercado particular. Opcional.
PESQUISA_UF=DF
PESQUISA_REGIAO=Brasília/Distrito Federal

# Modelos usados nas chamadas de IA — opcional, sobrescreve os padrões do
# código. Confira sempre os identificadores vigentes na documentação oficial
# (Google AI Studio / Anthropic) antes de trocar; um nome de modelo aposentado
# quebra a chamada até você atualizar aqui.
# GEMINI_MODELOS=gemini-2.5-flash,gemini-flash-lite-latest,gemini-3.6-flash
# CLAUDE_MODELO_PESQUISA=claude-sonnet-5

# Preparação pra sair do PC local / rede local (não precisa mexer em nada
# disso hoje — só existe pra quando migrar pra uma VPS, ver README 8.2):
# - CORS_ORIGINS: lista de origens liberadas, separadas por vírgula. Sem
#   definir, mantém o padrão de hoje (localhost + rede 192.168.x.x).
# CORS_ORIGINS=https://seusite.com.br
# - TRUST_PROXY: só definir se o Node rodar atrás de um proxy reverso (nginx
#   etc.) — sem isso, o rate limit passaria a contar todo mundo como o IP do
#   proxy e bloquearia todo mundo junto no primeiro abuso.
# TRUST_PROXY=1

# Limites de conexão com o Postgres — opcional, os padrões já são seguros
# pra rodar no mesmo PC que a API e o Puppeteer.
# DB_POOL_MAX=10
# DB_STATEMENT_TIMEOUT_MS=30000

# Servidor MCP (Claude Desktop) — backend/src/mcp/mcpServer.mjs. Ele fala com
# esta mesma API logado como um usuário dedicado (crie um pela tela Usuários,
# papel admin) — nunca usa acesso direto ao banco. Veja o passo a passo em
# backend/src/mcp/README.md.
# MCP_API_URL=http://localhost:3001
# MCP_LOGIN_EMAIL=mcp@hmengenharia.com
# MCP_LOGIN_SENHA=

# Pasta exclusiva do sistema para os arquivos de cada projeto analisado e de cada
# laudo (subpastas Projetos/<nome> e Laudos/<nome>). Padrão: C:/HM-Engenharia/Arquivos do Sistema
# PASTA_ARQUIVOS_SISTEMA=

# HTTPS opcional para o app de campo (/campo no celular): o service worker, que
# deixa o app abrir SEM rede, só funciona em HTTPS. Com as três variáveis, o
# backend abre TAMBÉM esta porta em HTTPS (o HTTP da PORT continua igual); sem
# elas, nada muda. Certificado: .pem/.crt + .key, ou um .pfx/.p12 em
# HTTPS_CERTIFICADO (HTTPS_CHAVE fica vazio; HTTPS_SENHA = senha do .pfx).
# Como gerar um certificado para a rede local: docs/CAMPO-API.md.
# HTTPS_PORTA=
# HTTPS_CERTIFICADO=
# HTTPS_CHAVE=
# HTTPS_SENHA=
